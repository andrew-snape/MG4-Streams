<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playlist for"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slotRadio"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="Radio" />

            <Button
                android:id="@+id/slotTv"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="TV" />

            <Button
                android:id="@+id/slotMine"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="My list" />
        </LinearLayout>

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:hint="Playlist URL (.m3u / .m3u8)"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addUrlButton"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:text="Add URL" />

            <Button
                android:id="@+id/importButton"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:text="Import file" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:text="Clear list" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/importUrlsButton"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:text="Import address list (.txt)" />

            <Button
                android:id="@+id/refreshButton"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:text="Update all playlists" />
        </LinearLayout>

        <Switch
            android:id="@+id/autoResumeSwitch"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Auto-resume last station on start (not TV)"
            android:textSize="22sp" />

        <Switch
            android:id="@+id/nightDimSwitch"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Dim the screen at night (7 pm to 6 am)"
            android:textSize="22sp" />

        <Switch
            android:id="@+id/albumArtSwitch"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Album art for songs (sends the song title to Apple iTunes search)"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/dataUsageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textSize="20sp" />

        <Button
            android:id="@+id/updateButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Check for app updates" />

        <Button
            android:id="@+id/arrangePresetsButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Arrange presets (order of favourites)" />

        <Button
            android:id="@+id/netCheckButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Network check (tests the station on screen)" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
